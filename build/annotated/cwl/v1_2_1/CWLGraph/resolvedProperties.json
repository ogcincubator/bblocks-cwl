1_2_1.requirements.cwltool-CUDARequirement"]},{"path":["$graph","hints","_anyOf","0","cwltool:CUDARequirement","cudaDeviceCountMin"],"title":"CUDA device count minimum","description":"The minimum amount of devices required.","schema_type":"integer","sources":["bblocks://ogc.cwl.v1_2_1.requirements.cwltool-CUDARequirement"]},{"path":["$graph","hints","_anyOf","0","cwltool:CUDARequirement","cudaDeviceCountMax"],"title":"CUDA device count maximum","description":"The maximum amount of devices required.","schema_type":"integer","sources":["bblocks://ogc.cwl.v1_2_1.requirements.cwltool-CUDARequirement"]},{"path":["$graph","hints","_anyOf","0","cwltool:CUDARequirement","cudaComputeCapability"],"title":"CUDA compute capability","description":"The compute capability supported by the GPU hardware.\n\n* If this is a single value, it defines only the minimum compute capability.\n  GPUs with higher capability are also accepted.\n* If it is an array value, then only select GPUs with compute capabilities that explicitly\n  appear in the array.\n  See https://docs.nvidia.com/deploy/cuda-compatibility/#faq and\n  https://docs.nvidia.com/cuda/cuda-c-best-practices-guide/index.html#cuda-compute-capability\n  for details.\n","required":true,"sources":["bblocks://ogc.cwl.v1_2_1.requirements.cwltool-CUDARequirement"]},{"path":["$graph","hints","_anyOf","0","cwltool:CUDARequirement","class"],"schema_type":"string","enum":["cwltool:CUDARequirement"],"sources":["bblocks://ogc.cwl.v1_2_1.requirements.cwltool-CUDARequirement"]},{"path":["$graph","hints","_anyOf","0","WorkReuse"],"id":"https://w3id.org/cwl/cwl#WorkReuse","sources":["bblocks://ogc.cwl.v1_2_1.requirements.CWLRequirementsMap"],"effectiveId":"https://w3id.org/cwl/cwl#WorkReuse"},{"path":["$graph","hints","_anyOf","0","WorkReuse","enableReuse"],"id":"https://w3id.org/cwl/cwl#WorkReuse/enableReuse","title":"EnableReuseValue","description":"Indicates if reuse is enabled for this tool.\n\nCan be an expression when combined with 'InlineJavascriptRequirement'\n(see also: https://www.commonwl.org/v1.2/CommandLineTool.html#Expression).\n","required":true,"sources":["bblocks://ogc.cwl.v1_2_1.requirements.WorkReuseRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#WorkReuse/enableReuse"},{"path":["$graph","hints","_anyOf","0","WorkReuse","class"],"id":"@type","schema_type":"string","enum":["WorkReuse"],"sources":["bblocks://ogc.cwl.v1_2_1.requirements.WorkReuseRequirement"],"effectiveId":"@type"},{"path":["$graph","hints","_anyOf","0","ToolTimeLimit"],"id":"https://w3id.org/cwl/cwl#ToolTimeLimit","sources":["bblocks://ogc.cwl.v1_2_1.requirements.CWLRequirementsMap"],"effectiveId":"https://w3id.org/cwl/cwl#ToolTimeLimit"},{"path":["$graph","hints","_anyOf","0","ToolTimeLimit","timelimit"],"id":"https://w3id.org/cwl/cwl#ToolTimeLimit/timelimit","title":"TimeLimitValue","description":"The time limit, in seconds.\n\nA time limit of zero means no time limit.\nNegative time limits are an error.\n","required":true,"sources":["bblocks://ogc.cwl.v1_2_1.requirements.ToolTimeLimitRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#ToolTimeLimit/timelimit"},{"path":["$graph","hints","_anyOf","0","ToolTimeLimit","class"],"id":"@type","schema_type":"string","enum":["ToolTimeLimit"],"sources":["bblocks://ogc.cwl.v1_2_1.requirements.ToolTimeLimitRequirement"],"effectiveId":"@type"},{"path":["$graph","hints","_anyOf","0","SubworkflowFeatureRequirement"],"id":"https://w3id.org/cwl/cwl#SubworkflowFeatureRequirement","sources":["bblocks://ogc.cwl.v1_2_1.requirements.CWLRequirementsMap"],"effectiveId":"https://w3id.org/cwl/cwl#SubworkflowFeatureRequirement"},{"path":["$graph","hints","_anyOf","0","SubworkflowFeatureRequirement","class"],"description":"CWL requirement class specification.","schema_type":"string","enum":["SubworkflowFeatureRequirement"],"sources":["bblocks://ogc.cwl.v1_2_1.requirements.SubworkflowFeatureRequirement"]},{"path":["$graph","hints","_anyOf","0","StepInputExpressionRequirement"],"id":"https: