alWorkDirRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#listing"},{"path":["_oneOf","0","_oneOf","7"],"title":"InlineJavascriptRequirement","sources":["bblocks://ogc.cwl.v1_2_1.requirements.InlineJavascriptRequirement"],"keyword":"branch"},{"path":["_oneOf","0","_oneOf","7","class"],"id":"@type","schema_type":"string","enum":["InlineJavascriptRequirement"],"sources":["bblocks://ogc.cwl.v1_2_1.requirements.InlineJavascriptRequirement"],"effectiveId":"@type"},{"path":["_oneOf","0","_oneOf","7","expressionLib"],"id":"https://w3id.org/cwl/cwl#InlineJavascriptRequirement/expressionLib","title":"InlineJavascriptLibraries","description":"Additional code fragments that will also be inserted before executing the expression code.\nAllows for function definitions that may be called from CWL expressions.\n","required":true,"schema_type":"array","sources":["bblocks://ogc.cwl.v1_2_1.requirements.InlineJavascriptRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#InlineJavascriptRequirement/expressionLib"},{"path":["_oneOf","0","_oneOf","8"],"title":"InplaceUpdateRequirement","sources":["bblocks://ogc.cwl.v1_2_1.requirements.InplaceUpdateRequirement"],"keyword":"branch"},{"path":["_oneOf","0","_oneOf","8","class"],"id":"@type","schema_type":"string","enum":["InplaceUpdateRequirement"],"sources":["bblocks://ogc.cwl.v1_2_1.requirements.InplaceUpdateRequirement"],"effectiveId":"@type"},{"path":["_oneOf","0","_oneOf","8","inplaceUpdate"],"id":"https://w3id.org/cwl/cwl#InplaceUpdateRequirement/inplaceUpdate","title":"inplaceUpdate","required":true,"schema_type":"boolean","sources":["bblocks://ogc.cwl.v1_2_1.requirements.InplaceUpdateRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#InplaceUpdateRequirement/inplaceUpdate"},{"path":["_oneOf","0","_oneOf","9"],"title":"LoadListingRequirement","sources":["bblocks://ogc.cwl.v1_2_1.requirements.LoadListingRequirement"],"keyword":"branch"},{"path":["_oneOf","0","_oneOf","9","class"],"id":"@type","schema_type":"string","enum":["LoadListingRequirement"],"sources":["bblocks://ogc.cwl.v1_2_1.requirements.LoadListingRequirement"],"effectiveId":"@type"},{"path":["_oneOf","0","_oneOf","9","loadListing"],"id":"https://w3id.org/cwl/cwl#loadListing","required":true,"sources":["bblocks://ogc.cwl.v1_2_1.requirements.LoadListingRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#loadListing"},{"path":["_oneOf","0","_oneOf","10"],"title":"NetworkAccessRequirement","sources":["bblocks://ogc.cwl.v1_2_1.requirements.NetworkAccessRequirement"],"keyword":"branch"},{"path":["_oneOf","0","_oneOf","10","class"],"id":"@type","schema_type":"string","enum":["NetworkAccess"],"sources":["bblocks://ogc.cwl.v1_2_1.requirements.NetworkAccessRequirement"],"effectiveId":"@type"},{"path":["_oneOf","0","_oneOf","10","networkAccess"],"id":"https://w3id.org/cwl/cwl#NetworkAccess/networkAccess","title":"NetworkAccess","description":"Indicate whether a process requires outgoing IPv4/IPv6 network access.","required":true,"sources":["bblocks://ogc.cwl.v1_2_1.requirements.NetworkAccessRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#NetworkAccess/networkAccess"},{"path":["_oneOf","0","_oneOf","11"],"title":"ResourceRequirement","sources":["bblocks://ogc.cwl.v1_2_1.requirements.ResourceRequirement"],"keyword":"branch"},{"path":["_oneOf","0","_oneOf","11","class"],"id":"@type","schema_type":"string","enum":["ResourceRequirement"],"sources":["bblocks://ogc.cwl.v1_2_1.requirements.ResourceRequirement"],"effectiveId":"@type"},{"path":["_oneOf","0","_oneOf","11","coresMin"],"id":"https://w3id.org/cwl/cwl#ResourceRequirement/coresMin","description":"Minimum reserved number of CPU cores (default is 1).\n\nMay be a fractional value to indicate to a scheduling algorithm that one core can be allocated to\nmultiple jobs. For example, a value of 0.25 indicates that up to 4 jobs\nmay run in parallel on 1 core. A value of 1.25 means that up to 3 jobs\ncan run on a 4 core system (4/1.25 ~ 3).\n\nProcesses can only share a core allocation if the sum of each of their 'ramMax', 'tmpdirMax', and\n'outdirMax' requests also do not exceed the capacity of the node.\n\nProcesses sharing a core must have the same level of isolation (typically a container\nor VM) that they would normally have.\n\nThe reported number of CPU cores reserved for the process, which is available to expressions\non the 'CommandLineTool' as 'runtime.cores', must be a non-zero integer, and may be calculated by\nrounding up the cores request to the next whole number.\n\nScheduling systems may allocate fractional CPU resources by setting quotas or scheduling weights.\nScheduling systems that do not support fractional CPUs may round up the request to the next whole number.\n","sources":["bblocks://ogc.cwl.v1_2_1.requirements.ResourceRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#ResourceRequirement/coresMin"},{"path":["_oneOf","0","_oneOf","11","coresMax"],"id":"https://w3id.org/cwl/cwl#ResourceRequirement/coresMax","description":"Maximum reserved number of CPU cores.\nSee 'coresMin' for discussion about fractional CPU requests.\n","sources":["bblocks://ogc.cwl.v1_2_1.requirements.ResourceRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#ResourceRequirement/coresMax"},{"path":["_oneOf","0","_oneOf","11","ramMin"],"id":"https://w3id.org/cwl/cwl#ResourceRequirement/ramMin","description":"Minimum reserved RAM in mebibytes (2**20) (default is 256).\n\nMay be a fractional value. If so, the actual RAM request must be rounded up\nto the next whole number.\n\nThe reported amount of RAM reserved for the process, which is available to\nexpressions on the 'CommandLineTool' as 'runtime.ram', must be a non-zero integer.\n","sources":["bblocks://ogc.cwl.v1_2_1.requirements.ResourceRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#ResourceRequirement/ramMin"},{"path":["_oneOf","0","_oneOf","11","ramMax"],"id":"https://w3id.org/cwl/cwl#ResourceRequirement/ramMax","description":"Maximum reserved RAM in mebibytes (2**20).\nSee 'ramMin' for discussion about fractional RAM requests.\n","sources":["bblocks://ogc.cwl.v1_2_1.requirements.ResourceRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#ResourceRequirement/ramMax"},{"path":["_oneOf","0","_oneOf","11","outdirMin"],"id":"https://w3id.org/cwl/cwl#ResourceRequirement/outdirMin","description":"Minimum reserved filesystem based storage for the designated output\ndirectory in mebibytes (2**20).\n\nMay be a fractional value. If so, the actual storage request must be rounded\nup to the next whole number.\n\nThe reported amount of storage reserved for the process, which is available\nto expressions on the 'CommandLineTool' as 'runtime.outdirSize', must be a non-zero integer.\n","sources":["bblocks://ogc.cwl.v1_2_1.requirements.ResourceRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#ResourceRequirement/outdirMin"},{"path":["_oneOf","0","_oneOf","11","outdirMax"],"id":"https://w3id.org/cwl/cwl#ResourceRequirement/outdirMax","description":"Maximum reserved filesystem based storage for the designated output\ndirectory in mebibytes (2**20).\nSee 'outdirMin' for discussion about fractional storage requests.\n","sources":["bblocks://ogc.cwl.v1_2_1.requirements.ResourceRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#ResourceRequirement/outdirMax"},{"path":["_oneOf","0","_oneOf","11","tmpdirMin"],"id":"https://w3id.org/cwl/cwl#ResourceRequirement/tmpdirMin","description":"Minimum reserved filesystem based storage for the designated temporary\ndirectory in mebibytes (2**20).\n\nMay be a fractional value. If so, the actual storage request must be rounded\nup to the next whole number.\n\nThe reported amount of storage reserved for the process, which is available\nto expressions on the 'CommandLineTool' as 'runtime.tmpdirSize', must be a non-zero integer.\n","sources":["bblocks://ogc.cwl.v1_2_1.requirements.ResourceRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#ResourceRequirement/tmpdirMin"},{"path":["_oneOf","0","_oneOf","11","tmpdirMax"],"id":"https://w3id.org/cwl/cwl#ResourceRequirement/tmpdirMax","description":"Maximum reserved filesystem based storage for the designated temporary\ndirectory in mebibytes (2**20).\nSee 'tmpdirMin' for discussion about fractional storage requests.\n","sources":["bblocks://ogc.cwl.v1_2_1.requirements.ResourceRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#ResourceRequirement/tmpdirMax"},{"path":["_oneOf","0","_oneOf","12"],"title":"ScatterFeatureRequirement","sources":["bblocks://ogc.cwl.v1_2_1.requirements.ScatterFeatureRequirement"],"keyword":"branch"},{"path":["_oneOf","0","_oneOf","12","class"],"description":"CWL requirement class specification.","schema_type":"string","enum":["ScatterFeatureRequirement"],"sources":["bblocks://ogc.cwl.v1_2_1.requirements.ScatterFeatureRequirement"]},{"path":["_oneOf","0","_oneOf","13"],"title":"ToolTimeLimitRequirement","sources":["bblocks://ogc.cwl.v1_2_1.requirements.ToolTimeLimitRequirement"],"keyword":"branch"},{"path":["_oneOf","0","_oneOf","13","class"],"id":"@type","schema_type":"string","enum":["ToolTimeLimit"],"sources":["bblocks://ogc.cwl.v1_2_1.requirements.ToolTimeLimitRequirement"],"effectiveId":"@type"},{"path":["_oneOf","0","_oneOf","13","timelimit"],"id":"https://w3id.org/cwl/cwl#ToolTimeLimit/timelimit","title":"TimeLimitValue","description":"The time limit, in seconds.\n\nA time limit of zero means no time limit.\nNegative time limits are an error.\n","required":true,"sources":["bblocks://ogc.cwl.v1_2_1.requirements.ToolTimeLimitRequirement"],"effectiveId":"https://w3id.org/cwl/cwl#ToolTimeLimit/timelimit"},{"path":["_oneOf","0","_oneOf","14"],"title":"WorkReuseRequirement","sources":["bblocks://ogc.cwl.v1_2_1.requirements.WorkReuseRequirement"],"keyword":"branch"},{"path":["_oneOf","0","_oneOf","14","class"],"id":"@type","schema_type":"string","enum":["WorkReuse"],"sources":["bblocks://ogc.cwl.v1_2_1.requirements.WorkReuseRequirement"],"effectiveId":"@type"},{"path":["_oneOf","0","_oneOf","14","enableReuse"],"id":