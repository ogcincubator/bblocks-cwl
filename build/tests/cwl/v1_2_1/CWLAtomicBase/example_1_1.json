{
  "class": "CommandLineTool",
  "baseCommand": [
    "echo",
    "first"
  ],
  "inputs": {
    "in": {
      "type": "Any"
    }
  },
  "outputs": {
    "out": {
      "type": "string",
      "outputBinding": {
        "glob": "out.txt",
        "loadContents": true,
        "outputEval": "$(self[0].contents)"
      }
    }
  },
  "stdout": "out.txt"
}