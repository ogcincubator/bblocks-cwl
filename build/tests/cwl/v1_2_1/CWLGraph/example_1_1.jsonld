{
  "@context": "https://ogcincubator.github.io/bblocks-cwl/build/annotated/cwl/v1_2_1/CWLGraph/context.jsonld",
  "cwlVersion": "v1.2",
  "$graph": [
    {
      "class": "CommandLineTool",
      "id": "main",
      "inputs": {
        "in": {
          "type": "Any",
          "inputBinding": {}
        }
      },
      "outputs": {
        "out": {
          "type": "string",
          "outputBinding": {
            "glob": "out.txt",
            "loadContents": true,
            "outputEval": "$(self[0].contents)"
          }
        }
      },
      "baseCommand": "echo",
      "stdout": "out.txt"
    }
  ]
}