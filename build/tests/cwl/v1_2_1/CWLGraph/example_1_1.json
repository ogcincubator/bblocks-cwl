{
  "cwlVersion": "v1.2",
  "$graph": [
    {
      "class": "CommandLineTool",
      "id": "main",
      "inputs": {
        "in": {
          "type": "Any",
          "inputBinding": {}
        }
      },
      "outputs": {
        "out": {
          "type": "string",
          "outputBinding": {
            "glob": "out.txt",
            "loadContents": true,
            "outputEval": "$(self[0].contents)"
          }
        }
      },
      "baseCommand": "echo",
      "stdout": "out.txt"
    }
  ]
}