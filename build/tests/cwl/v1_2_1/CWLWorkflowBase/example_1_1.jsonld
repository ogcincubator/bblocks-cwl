{
  "@context": "https://ogcincubator.github.io/bblocks-cwl/build/annotated/cwl/v1_2_1/CWLWorkflowBase/context.jsonld",
  "inputs": {
    "file1": "File"
  },
  "outputs": {
    "count_output": {
      "type": "int",
      "outputSource": "step1/count_output"
    }
  },
  "steps": {
    "step1": {
      "run": "count-lines1-wf.cwl",
      "in": {
        "file1": "file1"
      },
      "out": [
        "count_output"
      ]
    }
  }
}