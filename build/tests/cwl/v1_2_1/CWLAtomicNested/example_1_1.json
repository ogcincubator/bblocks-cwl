{
  "class": "CommandLineTool",
  "baseCommand": [
    "wc",
    "-l"
  ],
  "inputs": [
    {
      "id": "file1",
      "type": "File",
      "inputBinding": {
        "position": 1
      }
    }
  ],
  "outputs": [
    {
      "id": "output",
      "type": "File",
      "outputBinding": {
        "glob": "output.txt"
      }
    }
  ],
  "stdout": "output.txt"
}