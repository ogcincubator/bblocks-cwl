    {
      "itemIdentifier": "ogc.cwl.v1_2_1.ResourceRAMMinimum",
      "name": "ResourceRAMMinimum",
      "itemClass": "schema",
      "abstract": "Minimum reserved RAM in mebibytes (2**20).\n\nMay be a fractional value. If so, the actual RAM request must be rounded up\nto the next whole number.\n\nThe reported amount of RAM reserved for the process, which is available to\nexpressions on the 'CommandLineTool' as 'runtime.ram', must be a non-zero integer.\n",
      "status": "under-development",
      "dateTimeAddition": "2025-09-29T14:14:37.695361",
