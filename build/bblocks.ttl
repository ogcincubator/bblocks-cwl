<bblocks://ogc.cwl.v1_2_1.CWLAtomic> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "CWLAtomic" ;
    dct:abstract """A complete, top-level CWL document describing a single CommandLineTool,
ExpressionTool, or Workflow. Combines the process/workflow-specific fields (class, inputs, outputs,
requirements, hints, ...) with the document-level fields that only apply at the root of a CWL file:
`cwlVersion`, `s:keywords`/authorship-style metadata, and `label`/`doc`."""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-09-29T14:14:37.672835"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/json-full/cwl/v1_2_1/CWLAtomic/index.json> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/bblock/ogc.cwl.v1_2_1.CWLAtomic> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/markdown/cwl/v1_2_1/CWLAtomic/index.md> ] ;
    dct:hasVersion "1.2.1" ;
    dct:modified "2026-09-07"^^xsd:date ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-cwl/> ;
    skos:prefLabel "CWLAtomic" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-cwl/> ;
    dcat:keyword "cwl" ;
    prof:hasResource [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-cwl/build/annotated/cwl/v1_2_1/CWLAtomic/context.jsonld> ;
            prof:hasRole role:mapping ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-cwl/build/annotated/cwl/v1_2_1/CWLAtomic/schema.json> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-cwl/build/annotated/cwl/v1_2_1/CWLAtomic/schema.yaml> ;
            prof:hasRole role:schema ] ;
    prof:isProfileOf <bblocks://ogc.cwl.v1_2_1.CWLAtomicBase> ;
