        <bblocks://ogc.cwl.v1_2_1.CWLVersion> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

<bblocks://ogc.cwl.v1_2_1.CWLAtomicNested> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "CWLAtomicNested" ;
    dct:abstract """Same shape as `CWLAtomic`, for use when a CommandLineTool,
ExpressionTool, or Workflow definition is embedded inline as the `run` value of a Workflow step,
instead of being referenced by file or URL. `cwlVersion` is not repeated here, since it is only
declared once at the document root."""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-09-29T14:14:37.710771"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/json-full/cwl/v1_2_1/CWLAtomicNested/index.json> ],
