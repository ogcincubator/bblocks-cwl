<bblocks://ogc.cwl.v1_2_1.CWLFileOnlyParameters> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "CWLFileOnlyParameters" ;
    dct:abstract """Parameters that only apply to File-typed (or File-array-typed)
inputs/outputs: `format` (the file's content format/media type, as an IRI or CWL expression),
`streamable`, `loadContents` (whether to load the first 64 KiB of file content for use in
expressions), and `secondaryFiles` (associated files expected alongside the primary one)."""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-09-29T14:14:37.714105"^^xsd:dateTime ;
