<bblocks://ogc.cwl.v1_2_1.SchemaSaladOntology> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "Schema Salad Ontology" ;
    dct:abstract """The RDFS vocabulary/ontology for Schema Salad, the schema language CWL is defined in, published
alongside CWL v1.2 at `https://w3id.org/cwl/salad#` (`sld:`). It defines the metaschema classes used
to describe CWL's own record/enum/array schemas (`RecordSchema`, `EnumSchema`, `JsonldPredicate`, ...),
distinct from the CWL document vocabulary itself (see [CWL Ontology](bblocks://ogc.cwl.v1_2_1.CWLOntology))."""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-08-18T19:19:38.980748"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/bblock/ogc.cwl.v1_2_1.SchemaSaladOntology> ],
