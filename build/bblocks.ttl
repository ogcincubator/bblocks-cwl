<bblocks://ogc.cwl.v1_2_1.requirements.OGCAPIRequirement> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "OGCAPIRequirement" ;
    dct:abstract """Hint indicating that the Application Package corresponds to an
OGC API - Processes provider that should be remotely executed and monitored
