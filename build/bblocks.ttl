<bblocks://ogc.cwl.v1_2_1.requirements.DockerRequirement> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "DockerRequirement" ;
    dct:abstract """Indicates that a CommandLineTool or ExpressionTool should be run
in a Docker or Docker-compatible (e.g. Singularity, udocker) container, and specifies how to fetch
or build the image (`dockerPull`, `dockerImport`, `dockerLoad`, or `dockerFile`). If listed under
`hints`, the platform may run the tool in the container; if listed under `requirements`, it must.
See the [CWL v1.2 CommandLineTool spec — DockerRequirement](https://www.commonwl.org/v1.2/CommandLineTool.html#DockerRequirement)
for the full behavior, including bind-mount and entrypoint handling."""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-09-29T14:14:37.683513"^^xsd:dateTime ;
    dct:description [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/markdown/cwl/v1_2_1/requirements/DockerRequirement/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/json-full/cwl/v1_2_1/requirements/DockerRequirement/index.json> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/bblock/ogc.cwl.v1_2_1.requirements.DockerRequirement> ] ;
    dct:hasVersion "1.2.1" ;
    dct:modified "2026-09-07"^^xsd:date ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-cwl/> ;
    skos:prefLabel "DockerRequirement" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-cwl/> ;
    dcat:keyword "cwl" ;
    prof:hasResource [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
