            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/markdown/cwl/v1_2_1/SchemaSaladOntology/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/json-full/cwl/v1_2_1/SchemaSaladOntology/index.json> ] ;
    dct:hasVersion "1.2.1" ;
    dct:modified "2026-09-07"^^xsd:date ;
    skos:closeMatch <https://w3id.org/cwl/salad#> ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-cwl/> ;
    skos:prefLabel "Schema Salad Ontology" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-cwl/> ;
