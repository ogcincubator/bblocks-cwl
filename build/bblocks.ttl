<bblocks://ogc.cwl.v1_2_1.CWLDefaultTypedConditional> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "CWLDefaultTypedConditional" ;
    dct:abstract """Validates that a `default` value, if given alongside a
`type`, actually matches that declared type (e.g. a `default` for `type: boolean` must be a JSON
boolean, one for an `enum` type must be one of its `symbols`, one for `File`/`Directory` must be a
literal file/directory object). Limits itself to data literals and arrays; nested or multi-type
`type` definitions validate against `Any` instead of being over-constrained."""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-09-29T14:14:37.699245"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/json-full/cwl/v1_2_1/CWLDefaultTypedConditional/index.json> ],
