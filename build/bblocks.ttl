    bblocks:validationPassed true .

<https://ogcincubator.github.io/bblocks-cwl/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - Common Workflow Language building blocks" ;
    dct:abstract """Common Workflow Language (CWL) is an open standard for describing how to run command line tools and connect them to create workflows.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:description """Tools and workflows described using CWL are portable across a variety of platforms that support the CWL standards. 
Using CWL, it is easy to scale complex data analysis and machine learning workflows from a single
developer's laptop up to massively parallel cluster, cloud and high performance computing environments.

More information at [the Common Workflow Language website](https://www.commonwl.org/).
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:modified "2026-09-07T11:25:26.777680"^^xsd:dateTime ;
    void:sparqlEndpoint <https://defs-dev.opengis.net/fuseki/query> ;
    owl:imports <https://opengeospatial.github.io/bblocks/register.json> ;
    skos:hasTopConcept <bblocks://ogc.cwl.v1_2_1.CWL>,
        <bblocks://ogc.cwl.v1_2_1.CWLArguments>,
        <bblocks://ogc.cwl.v1_2_1.CWLAtomic>,
        <bblocks://ogc.cwl.v1_2_1.CWLAtomicBase>,
        <bblocks://ogc.cwl.v1_2_1.CWLAtomicNested>,
        <bblocks://ogc.cwl.v1_2_1.CWLCommand>,
        <bblocks://ogc.cwl.v1_2_1.CWLDefault>,
        <bblocks://ogc.cwl.v1_2_1.CWLDefaultLocation>,
        <bblocks://ogc.cwl.v1_2_1.CWLDefaultTypedConditional>,
        <bblocks://ogc.cwl.v1_2_1.CWLDirectoryOnlyParameters>,
