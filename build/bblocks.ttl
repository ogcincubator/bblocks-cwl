<bblocks://ogc.cwl.v1_2_1.CWLIntent> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "CWLIntent" ;
    dct:abstract """An identifier for the type of computational operation a process
performs, especially useful for `Operation` but also usable on `CommandLineTool`, `Workflow`, or
`ExpressionTool`. If provided, must be an IRI of a concept node representing the operation type,
preferably defined within an ontology — for example an EDAM Ontology operation concept such as
`http://edamontology.org/operation_2928` (Alignment)."""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-09-29T14:14:37.676051"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/json-full/cwl/v1_2_1/CWLIntent/index.json> ],
