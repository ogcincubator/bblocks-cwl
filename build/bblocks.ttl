<bblocks://ogc.cwl.v1_2_1.requirements.ShellCommandRequirement> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "ShellCommandRequirement" ;
    dct:abstract """Modifies CommandLineTool execution to generate a single
shell command-line string: each item in `arguments` is joined with spaces and shell-quoted, unless
its `CommandLineBinding` sets `shellQuote: false` — in which case it is joined unquoted, allowing
shell metacharacters such as `|` for pipes."""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-09-29T14:14:37.684354"^^xsd:dateTime ;
