        bblocks:Schema ;
    rdfs:label "CWLGraphItem" ;
    dct:abstract """A single process or workflow definition entry inside a `$graph`-form
CWL document (see `CWLGraph`): the `class`-discriminated CommandLineTool/ExpressionTool/Workflow
