<bblocks://ogc.cwl.v1_2_1.CWLGraph> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "CWLGraph" ;
    dct:abstract """A CWL document using the `$graph` form: instead of a single process or
workflow definition at the document root, the root carries a `$graph` array (in this register,
constrained to exactly one entry) of process/workflow definitions, plus the shared `cwlVersion` and
document-level metadata/documentation fields."""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-09-29T14:14:37.673077"^^xsd:dateTime ;
    dct:description [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/markdown/cwl/v1_2_1/CWLGraph/index.md> ],
