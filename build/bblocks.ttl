<bblocks://ogc.cwl.v1_2_1.requirements.NetworkAccessRequirement> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "NetworkAccessRequirement" ;
    dct:abstract """`cwltool` extension hint/requirement indicating whether a
process needs outgoing network access. If not specified or false, tools must not assume network
access beyond localhost; if true, the tool may make outgoing connections, though implementations may
still apply their own security policies. Does not imply a publicly routable address or inbound
connections."""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-09-29T14:14:37.686363"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/json-full/cwl/v1_2_1/requirements/NetworkAccessRequirement/index.json> ],
