<bblocks://ogc.cwl.v1_2_1.CWL> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "CWL" ;
    dct:abstract """The root of the register: a Common Workflow Language v1.2.1 Application Package document.

A CWL document is one of three top-level forms: a single CommandLineTool/ExpressionTool/Workflow
definition (`CWLAtomic`), the same wrapped as a nested `run` definition inside a Workflow step
(`CWLAtomicNested`), or a `$graph`-wrapped document (`CWLGraph`)."""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-09-29T14:14:37.672484"^^xsd:dateTime ;
    dct:description [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/markdown/cwl/v1_2_1/CWL/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/json-full/cwl/v1_2_1/CWL/index.json> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/bblock/ogc.cwl.v1_2_1.CWL> ] ;
    dct:hasVersion "1.2.1" ;
    dct:modified "2026-09-07"^^xsd:date ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-cwl/> ;
    skos:prefLabel "CWL" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-cwl/> ;
    dcat:keyword "cwl" ;
    prof:hasResource [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-cwl/build/annotated/cwl/v1_2_1/CWL/schema.json> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-cwl/build/annotated/cwl/v1_2_1/CWL/context.jsonld> ;
            prof:hasRole role:mapping ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-cwl/build/annotated/cwl/v1_2_1/CWL/schema.yaml> ;
            prof:hasRole role:schema ] ;
    bblocks:dependsOn <bblocks://ogc.cwl.v1_2_1.CWLAtomic>,
        <bblocks://ogc.cwl.v1_2_1.CWLGraph>,
        <bblocks://ogc.cwl.v1_2_1.CWLWorkflow> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

