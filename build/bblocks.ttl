<bblocks://ogc.cwl.v1_2_1.requirements.InitialWorkDirRequirement> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "InitialWorkDirRequirement" ;
    dct:abstract """Defines a list of files and subdirectories that must be
staged by the workflow platform prior to executing the command line tool, normally within the
designated output directory (though containers may stage them elsewhere)."""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-09-29T14:14:37.685221"^^xsd:dateTime ;
