    dct:modified "2026-09-07"^^xsd:date ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-cwl/> ;
    skos:prefLabel "CWLDefaultTypedConditional" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-cwl/> ;
    dcat:keyword "cwl" ;
    prof:hasResource [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-cwl/build/annotated/cwl/v1_2_1/CWLDefaultTypedConditional/context.jsonld> ;
