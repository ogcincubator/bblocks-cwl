<bblocks://ogc.cwl.v1_2_1.CWLScatterMethod> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "CWLScatterMethod" ;
    dct:abstract """Describes how to decompose the scattered input into a discrete
set of jobs. When 'dotproduct', specifies that each of the input arrays
are aligned and one element taken from each array to construct each job.
It is an error if all input arrays are of different length. When 'nested_crossproduct',
specifies the Cartesian product of the inputs, producing a job for every
combination of the scattered inputs. The output must be nested arrays
for each level of scattering, in the order that the input arrays are listed
in the scatter field. When 'flat_crossproduct', specifies the Cartesian
product of the inputs, producing a job for every combination of the scattered
inputs. The output arrays must be flattened to a single level, but otherwise
listed in the order that the input arrays are listed in the scatter field.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-09-29T14:14:37.678164"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/json-full/cwl/v1_2_1/CWLScatterMethod/index.json> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/build/generateddocs/markdown/cwl/v1_2_1/CWLScatterMethod/index.md> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-cwl/bblock/ogc.cwl.v1_2_1.CWLScatterMethod> ] ;
    dct:hasVersion "1.2.1" ;
    dct:modified "2026-09-07"^^xsd:date ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-cwl/> ;
    skos:prefLabel "CWLScatterMethod" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-cwl/> ;
    dcat:keyword "cwl" ;
    prof:hasResource [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-cwl/build/annotated/cwl/v1_2_1/CWLScatterMethod/schema.yaml> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
